# Export variables explicitly in your shell; the service does not auto-load .env.
# SQLite must live on persistent writable storage, never a Vercel ephemeral function.
EDGE_DB=.runtime/edge.sqlite3
# Optional Jupiter credential. Confirm free plan, terms and endpoint access first.
# Never paste an actual key into a tracked file or browser code.
# JUPITER_API_KEY=
# UI tests can use an installed Chrome/Chromium executable:
PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium
